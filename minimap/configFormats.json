{
  "schemaVersion": 1,
  "displayName": "Minimap",
  "configs": [
    { "type": "title", "label": "General" },
    { "key": "enabled", "type": "checkbox", "label": "Enabled" },
    { "key": "expandHotkey", "type": "keybinding", "label": "Expand map" },
    { "key": "circular", "type": "checkbox", "label": "Circular minimap" },
    { "key": "leftCorner", "type": "checkbox", "label": "Show in left corner" },
    { "key": "showNorthIndicator", "type": "checkbox", "label": "Show north indicator" },
    { "key": "showCategoryButtons", "type": "checkbox", "label": "Show category buttons" },
    { "key": "clockTimerMode", "type": "dropdown", "label": "Show clock/timer", "options": ["None", "Rift timer", "Clock"] },
    { "key": "riftAlerts", "type": "checkbox", "label": "Rift alerts" },
    { "key": "size", "type": "slider", "label": "Size", "min": 160, "max": 400, "step": 10 },
    { "key": "zoom", "type": "slider", "label": "Zoom %", "min": 10, "max": 300, "step": 10 },
    { "key": "transparency", "type": "slider", "label": "Transparency", "min": 0, "max": 100, "step": 1 },
    { "key": "rotateMap", "type": "checkbox", "label": "Rotate minimap" },
    { "key": "followCamera", "type": "checkbox", "label": "Rotation follows camera" },
    { "key": "xOffset", "type": "slider", "label": "X offset %", "min": 0, "max": 100, "step": 1 },
    { "key": "yOffset", "type": "slider", "label": "Y offset %", "min": 0, "max": 100, "step": 1 },
    { "type": "title", "label": "Markers" },
    { "key": "markerScale", "type": "slider", "label": "Marker scale %", "min": 50, "max": 200, "step": 10 },
    { "key": "showPlayers", "type": "checkbox", "label": "Show other players" },
    { "key": "hideNonPartyPlayers", "type": "checkbox", "label": "Hide players outside your party" },
    { "key": "partyDirectionArrows", "type": "checkbox", "label": "Party direction arrows" },
    { "key": "showRespawnPoints", "type": "checkbox", "label": "Show respawn points" },
    { "key": "showObelisks", "type": "checkbox", "label": "Show obelisks" },
    { "key": "showSoulstoneCircles", "type": "checkbox", "label": "Show soulstone summoning circles" },
    { "key": "showNpcs", "type": "checkbox", "label": "Show NPCs" },
    { "key": "showChests", "type": "checkbox", "label": "Show chests" },
    { "key": "showSecretOrbs", "type": "checkbox", "label": "Show secret orbs" },
    { "key": "hideVerticallyDistantMarkers", "type": "checkbox", "label": "Hide vertically distant markers" },
    { "key": "verticallyDistantThreshold", "type": "slider", "label": "Vertically distant threshold", "min": 15, "max": 100, "step": 1 },
    { "type": "title", "label": "Activities" },
    { "key": "showActivities", "type": "checkbox", "label": "Show activities" },
    { "key": "hideCompletedActivities", "type": "checkbox", "label": "Hide completed activities" },
    { "key": "hideAscensions", "type": "checkbox", "label": "Hide ascensions" },
    { "key": "hideDungeons", "type": "checkbox", "label": "Hide dungeons" },
    { "key": "hideInactiveRifts", "type": "checkbox", "label": "Hide inactive Rift locations" },
    { "type": "title", "label": "Ore" },
    { "key": "showOre", "type": "checkbox", "label": "Show ore" },
    { "key": "hideCopper", "type": "checkbox", "label": "Hide Copper" },
    { "key": "hideIron", "type": "checkbox", "label": "Hide Iron" },
    { "key": "hideTin", "type": "checkbox", "label": "Hide Tin" },
    { "key": "hideTungstene", "type": "checkbox", "label": "Hide Tungstene" },
    { "type": "title", "label": "Plants" },
    { "key": "showPlants", "type": "checkbox", "label": "Show plants" },
    { "key": "hideMadrigold", "type": "checkbox", "label": "Hide Madrigold" },
    { "key": "hideLavendula", "type": "checkbox", "label": "Hide Lavendula" },
    { "key": "hideAncientThyme", "type": "checkbox", "label": "Hide Ancient Thyme" },
    { "key": "hideZealotus", "type": "checkbox", "label": "Hide Zealotus" },
    { "type": "title", "label": "Enemies" },
    { "key": "showEnemies", "type": "checkbox", "label": "Show enemies" },
    { "key": "alwaysShowEliteEnemies", "type": "checkbox", "label": "Always show elite enemies" },
    { "key": "hideMasteredCodexEnemies", "type": "checkbox", "label": "Hide mastered Codex enemies" },
    { "key": "hideCompletedCodexEnemies", "type": "checkbox", "label": "Hide partially completed Codex enemies" },
    { "key": "hideTargetDummies", "type": "checkbox", "label": "Hide target dummies" },
    { "type": "title", "label": "Companions" },
    { "key": "showCompanions", "type": "checkbox", "label": "Show companions" },
    { "key": "hideCollectedCompanions", "type": "checkbox", "label": "Hide collected companions" },
    { "key": "sparklingCompanionAlerts", "type": "checkbox", "label": "Sparkling companion alerts" }
  ]
}
