-lib hlx-runtime
-D hl-ver=1.16.0
-cp src
-cp ../shared/src
-resource assets/ready-check-go.ogg@dps-meter/ready-check-go.ogg
-resource assets/ready-check-countdown.ogg@dps-meter/ready-check-countdown.ogg
-resource assets/fareverly-icon.png@dps-meter/fareverly-icon.png
-main dpsmeter.DpsMeterMod
-dce full
-hl build/dps-meter/implementation/dps-meter.hl

# Check required dependencies before linking the implementation.
--next
-D hl-ver=1.16.0
-cp ../shared/bootstrap
-D dependency-mod=dps-meter
-main moddependencies.Bootstrap
-dce full
-hl build/dps-meter/dps-meter.hl
