{
  "schemaVersion": 1,
  "displayName": "DPS Meter",
  "configs": [
    {"type": "title", "label": "General"},
    {"key": "enabled", "type": "checkbox", "label": "Enabled"},
    {"key": "modeHotkey", "type": "keybinding", "modifiers": true, "label": "Switch damage/healing hotkey", "tooltip": {"enabled": true, "tooltipText": "Switch between damage and healing in the meter, Fight History, and Rift Recap."}},
    {"type": "title", "label": "Fareverly"},
    {"key": "sendLogs", "type": "checkbox", "label": "Upload combat logs to Fareverly", "tooltip": {"enabled": true, "tooltipText": "Requires a Fareverly API key. Automatically submits new eligible boss victories. Combat statistics become public. Local logs are always kept."}},
    {"key": "fareverlyApiKey", "type": "text", "isSecret": true, "isCommon": true, "label": "Fareverly API key", "tooltip": {"enabled": true, "tooltipText": "This secret key connects your Farever account to Fareverly. Do not share it with anyone."}},
    {"key": "fareverlySignIn", "type": "button", "label": "Generate API key", "buttonText": "Generate API key", "tooltip": {"enabled": true, "tooltipText": "Sign in through Steam in your browser to create or replace your Fareverly key. Your current key remains valid until the new key is issued."}},
    {"type": "title", "label": "DPS Meter"},
    {"key": "hideOutOfCombat", "type": "checkbox", "label": "Hide when out of combat"},
    {"key": "hideDelay", "type": "slider", "label": "Hiding delay (seconds)", "min": 0, "max": 10, "step": 1},
    {"key": "meterScale", "type": "slider", "label": "UI scale (%)", "min": 50, "max": 150, "step": 5},
    {"key": "transparency", "type": "slider", "label": "Transparency", "min": 0, "max": 100, "step": 1},
    {"key": "toggleHotkey", "type": "keybinding", "modifiers": true, "label": "Show or hide meter hotkey"},
    {"key": "unlockHotkey", "type": "keybinding", "modifiers": true, "label": "Lock or unlock window hotkey", "tooltip": {"enabled": true, "tooltipText": "Enable or disable movement of DPS Meter and Fight History window"}},
    {"type": "title", "label": "Combat History"},
    {"key": "detailedCombatLogs", "type": "checkbox", "label": "Record detailed combat history", "tooltip": {"enabled": true, "tooltipText": "Records your skills, hits, defensive actions, procs, healing, shields and status changes in a timestamped timeline. Adds local detailed report files. Ordinary passive health regeneration is excluded."}},
    {"key": "historyHotkey", "type": "keybinding", "modifiers": true, "label": "Open or close history hotkey"},
    {"type": "title", "label": "Automatic Log Deletion"},
    {"key": "autoDeleteLogs", "type": "checkbox", "label": "Delete old logs automatically", "tooltip": {"enabled": true, "tooltipText": "Deletes expired local fight logs, detailed reports, and local submission files in the background. Published Fareverly reports are unaffected."}},
    {"key": "logRetentionMonths", "type": "slider", "label": "Delete logs older than (months)", "min": 1, "max": 24, "step": 1},
    {"type": "title", "label": "Kill Counter"},
    {"key": "showBossKills", "type": "checkbox", "label": "Show boss kills"},
    {"key": "showIncompleteCodexKills", "type": "checkbox", "label": "Show unmastered Codex kills"},
    {"key": "showCompletedCodexKills", "type": "checkbox", "label": "Show mastered Codex kills"},
    {"type": "title", "label": "Recaps"},
    {"key": "showRiftRecaps", "type": "checkbox", "label": "Show Rift recaps"},
    {"type": "title", "label": "Ready Check"},
    {"key": "readyCheckEnabled", "type": "checkbox", "label": "Enabled", "tooltip": {"enabled": true, "tooltipText": "Party leader: type rc to start. Type r or nr to respond. Accepts Local, All, or Group chat; commands are delivered through Group chat."}},
    {"key": "disableCountdownVoiceover", "type": "checkbox", "label": "Disable countdown voiceover", "tooltip": {"enabled": true, "tooltipText": "Mute the spoken 5, 4, 3, 2, 1 countdown for yourself."}},
    {"key": "disableCountdownAudio", "type": "checkbox", "label": "Disable countdown sound effects", "tooltip": {"enabled": true, "tooltipText": "Mute the everyone-ready sound and the GO boom for yourself."}}
  ]
}
