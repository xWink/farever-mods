{
  "schemaVersion": 1,
  "displayName": "DPS Meter",
  "configs": [
    { "type": "title", "label": "General" },
    { "key": "enabled", "type": "checkbox", "label": "Enabled" },
    { "key": "modeHotkey", "type": "keybinding", "label": "Switch damage/healing hotkey", "tooltip": { "enabled": true, "tooltipText": "Switch between damage and healing in the meter, Fight History, and Rift Recap." } },
    { "type": "title", "label": "DPS Meter" },
    { "key": "transparency", "type": "slider", "label": "Transparency", "min": 0, "max": 100, "step": 1 },
    { "key": "hideOutOfCombat", "type": "checkbox", "label": "Hide when out of combat" },
    { "key": "hideDelay", "type": "slider", "label": "Hiding delay (seconds)", "min": 0, "max": 10, "step": 1 },
    { "key": "sendLogs", "type": "checkbox", "label": "Upload combat logs to fareverlogs.fr" },
    { "key": "toggleHotkey", "type": "keybinding", "label": "Show or hide meter hotkey" },
    { "key": "unlockHotkey", "type": "keybinding", "label": "Lock or unlock window hotkey", "tooltip": { "enabled": true, "tooltipText": "Enable or disable movement of DPS Meter and Fight History window" } },
    { "type": "title", "label": "Combat History" },
    { "key": "historyHotkey", "type": "keybinding", "label": "Open or close history hotkey" },
    { "type": "title", "label": "Kill Counter" },
    { "key": "showBossKills", "type": "checkbox", "label": "Show boss kills" },
    { "key": "showIncompleteCodexKills", "type": "checkbox", "label": "Show unmastered Codex kills" },
    { "key": "showCompletedCodexKills", "type": "checkbox", "label": "Show mastered Codex kills" },
    { "type": "title", "label": "Recaps" },
    { "key": "showRiftRecaps", "type": "checkbox", "label": "Show Rift recaps" },
    { "type": "title", "label": "Diagnostics" },
    { "key": "healingTrace", "type": "checkbox", "label": "Record healing timing test", "tooltip": { "enabled": true, "tooltipText": "Record HP changes and experimental overheal calculations to healing-trace.jsonl in the DPS Meter folder. For short tests; does not change healing totals." } }
  ]
}
