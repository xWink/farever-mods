{
  "schemaVersion": 1,
  "displayName": "More Settings",
  "configs": [
    {
      "type": "title",
      "label": "General"
    },
    {
      "key": "disableProfanityFilter",
      "type": "checkbox",
      "label": "Disable profanity filter"
    },
    {
      "key": "showBossHealth",
      "type": "checkbox",
      "label": "Show boss health",
      "tooltip": {
        "enabled": true,
        "tooltipText": "Boss health bars will show the raw health value alongside percentage. Instead of just \"100%\", you will see \"150,000 (100%)\"."
      }
    },
    {
      "key": "performanceOptimization",
      "type": "checkbox",
      "label": "Performance improvements",
      "tooltip": {
        "enabled": true,
        "tooltipText": "Reduce the frequency and severity of lag and stutters."
      }
    },
    {
      "key": "performanceDiagnostics",
      "type": "checkbox",
      "label": "Performance diagnostics",
      "tooltip": {
        "enabled": true,
        "tooltipText": "Records timing information for freezes of 500 ms or longer. Keeps a small buffer in memory and writes to the mod log after combat. Enable while investigating freezes; works with Performance improvements on or off."
      }
    },
    {
      "key": "waitForParty",
      "type": "checkbox",
      "label": "Wait for party to enter dungeon",
      "tooltip": {
        "enabled": true,
        "tooltipText": "Prevents entering a dungeon solo while in a party."
      }
    },
    {
      "key": "leaveDungeonButton",
      "type": "checkbox",
      "label": "Leave dungeon button",
      "tooltip": {
        "enabled": true,
        "tooltipText": "Displays a button to leave dungeon while in a dungeon and not in combat."
      }
    },
    {
      "key": "hideUiKey",
      "type": "keybinding",
      "label": "Hide UI hotkey"
    },
    {
      "type": "title",
      "label": "Combat"
    },
    {
      "key": "fancyDamageNumbers",
      "type": "checkbox",
      "label": "Fancy damage numbers",
      "tooltip": {
        "enabled": true,
        "tooltipText": "Changes the appearance of damage numbers.\n\nBlue: magic hit\nBlue/pink: magic critical hit\nOrange: physical hit\nOrange/red: physical critical hit\nWhite: raw hit\nWhite/gold: raw critical hit\nGreen: heal\nGold/green: critical heal"
      }
    },
    {
      "key": "disableDamageNumbers",
      "type": "checkbox",
      "label": "Disable damage numbers",
      "tooltip": {
        "enabled": true,
        "tooltipText": "Hides floating damage and healing numbers, including incoming damage and healing numbers in the effects feed."
      }
    },
    {
      "key": "crabgantuaRockfallWarnings",
      "type": "checkbox",
      "label": "Improved Crabgantua rockfall warnings",
      "tooltip": {
        "enabled": true,
        "tooltipText": "Makes Crabgantua's rockfall warnings visible through the flooding water attack"
      }
    },
    {
      "key": "hideAlliedMinionHealthBars",
      "type": "checkbox",
      "label": "Hide allied minion HP bars",
      "tooltip": {
        "enabled": true,
        "tooltipText": "Hides health bars above allied minions. Your own summons' health bars remain visible."
      }
    },
    {
      "type": "title",
      "label": "Nameplates"
    },
    {
      "key": "classColoredNames",
      "type": "checkbox",
      "label": "Color player names by class"
    },
    {
      "key": "showNameplateWeapons",
      "type": "checkbox",
      "label": "Show equipped weapons"
    },
    {
      "type": "title",
      "label": "Social"
    },
    {
      "key": "hideFriendConnectionNotifications",
      "type": "checkbox",
      "label": "Hide friend connection notifications",
      "tooltip": {
        "enabled": true,
        "tooltipText": "Hides messages when friends connect or disconnect. Their online status still updates normally."
      }
    },
    {
      "key": "enableMissingSlashCommands",
      "type": "checkbox",
      "label": "Enable missing slash commands",
      "tooltip": {
        "enabled": true,
        "tooltipText": "/invite <player>: Invite a player to your party.\n/leave: Leave your party.\n/w <player>: Open a whisper to a player. Add a message after their name to send it immediately.\n\nNames are matched from your area, party, friends, or players seen in chat. Use quotes around names containing spaces."
      }
    },
    {
      "key": "sendingMessageClosesChat",
      "type": "checkbox",
      "label": "Sending message closes chat",
      "tooltip": {
        "enabled": true,
        "tooltipText": "Pressing Enter to send a message also closes the chat textbox, returning control of your character."
      }
    },
    {
      "key": "enableFriendNotes",
      "type": "checkbox",
      "label": "Enable friend notes",
      "tooltip": {
        "enabled": true,
        "tooltipText": "Add a private note of up to 30 characters from a friend's settings menu. Notes appear beside their name and are saved on this computer. Save an empty note to remove it."
      }
    },
    {
      "key": "rebindSocialInteract",
      "type": "checkbox",
      "label": "Rebind social interact hotkey",
      "tooltip": {
        "enabled": true,
        "tooltipText": "Use a separate hotkey to open another player's interaction menu. Hold the selected key while looking at them. Loot, NPC interactions, and reviving allies keep the regular Interact button."
      }
    },
    {
      "key": "socialInteractKey",
      "type": "keybinding",
      "label": "Social interact hotkey"
    },
    {
      "type": "title",
      "label": "Rift Effects"
    },
    {
      "key": "riftHideAllyAttacks",
      "type": "checkbox",
      "label": "Hide ally attacks"
    },
    {
      "key": "riftHideAllyBuffs",
      "type": "checkbox",
      "label": "Hide ally buffs"
    },
    {
      "key": "riftHideAllies",
      "type": "checkbox",
      "label": "Hide allies"
    },
    {
      "type": "title",
      "label": "Dungeon Effects"
    },
    {
      "key": "dungeonHideAllyAttacks",
      "type": "checkbox",
      "label": "Hide ally attacks"
    },
    {
      "key": "dungeonHideAllyBuffs",
      "type": "checkbox",
      "label": "Hide ally buffs"
    },
    {
      "key": "dungeonHideAllies",
      "type": "checkbox",
      "label": "Hide allies"
    },
    {
      "type": "title",
      "label": "Overworld Effects"
    },
    {
      "key": "overworldHideAllyAttacks",
      "type": "checkbox",
      "label": "Hide ally attacks"
    },
    {
      "key": "overworldHideAllyBuffs",
      "type": "checkbox",
      "label": "Hide ally buffs"
    },
    {
      "key": "overworldHideAllies",
      "type": "checkbox",
      "label": "Hide allies"
    }
  ]
}
